{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-relay.dev/schemas/task.schema.json",
  "title": "Codex Relay task",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "source_commit", "target", "objective", "validation_plan", "expected_results"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "source_commit": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "validation_plan": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "expected_results": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
