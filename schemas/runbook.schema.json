{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-relay.dev/schemas/runbook.schema.json",
  "title": "Code Relay runbook",
  "type": "object",
  "additionalProperties": false,
  "required": ["runbook_id", "source_commit", "target", "objective", "validation_plan", "expected_results"],
  "properties": {
    "runbook_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "source_commit": {"type": "string", "pattern": "^[a-fA-F0-9]{7,64}$"},
    "target": {"type": "string", "minLength": 1, "maxLength": 8192},
    "objective": {"type": "string", "minLength": 1, "maxLength": 8192},
    "validation_plan": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 8192}},
    "expected_results": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 8192}}
  }
}
