[Unit]
Description=Code Relay verifier agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=code-relay
WorkingDirectory=/var/lib/code-relay/project
ExecStart=/usr/local/bin/code-relay-agent daemon --root /var/lib/code-relay/project --role verifier --poll-interval 5
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
