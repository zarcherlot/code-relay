[Unit]
Description=Code Relay checkpoint agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=code-relay
WorkingDirectory=/var/lib/code-relay/project
ExecStart=/usr/local/bin/code-relay-agent daemon --root /var/lib/code-relay/project --role checkpoint --poll-interval 5
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
PrivateDevices=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/code-relay/project
MemoryMax=1G
CPUQuota=200%

[Install]
WantedBy=multi-user.target
