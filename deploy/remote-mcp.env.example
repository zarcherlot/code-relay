# Hosted mode (recommended for public ChatGPT submission) does not use a local
# checkout or CODE_RELAY_MCP_TOKEN. GitHub is the runbook/receipt source of truth.
CODE_RELAY_GITHUB_OAUTH_CLIENT_ID=
CODE_RELAY_GITHUB_OAUTH_CLIENT_SECRET=
# Prefer a mounted secret file in production; inline value takes precedence.
# CODE_RELAY_GITHUB_OAUTH_CLIENT_SECRET_FILE=/run/secrets/code-relay-github-oauth-client-secret
CODE_RELAY_GITHUB_OAUTH_REDIRECT_URL=https://mcp.example.com/auth/github/callback
CODE_RELAY_SESSION_SECRET=replace-with-a-random-32-character-secret
CODE_RELAY_GITHUB_APP_ID=
CODE_RELAY_GITHUB_APP_SLUG=code-relay
CODE_RELAY_GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/code-relay-github-app.pem
CODE_RELAY_GITHUB_WORKFLOW=checkpoint.yml
# Optional branch policy. Values are refs/heads/main or owner/repo@refs/heads/main.
CODE_RELAY_ALLOWED_REFS=

# Optional GitHub Enterprise endpoints.
CODE_RELAY_GITHUB_OAUTH_URL=https://github.com
CODE_RELAY_GITHUB_API_URL=https://api.github.com
CODE_RELAY_COOKIE_DOMAIN=
CODE_RELAY_COOKIE_SECURE=true

# Public Streamable HTTP resource and OAuth Protected Resource Metadata.
# These values must use the same HTTPS origin exposed by the reverse proxy.
CODE_RELAY_PUBLIC_BASE_URL=https://mcp.example.com
CODE_RELAY_OAUTH_RESOURCE_URL=https://mcp.example.com/mcp
CODE_RELAY_OAUTH_ISSUER_URL=https://mcp.example.com
CODE_RELAY_OAUTH_SCOPES=relay:read,relay:run
# MCP client registration for standard authorization-code + PKCE.
# Leave unset until the client redirect URI has been reviewed.
CODE_RELAY_MCP_OAUTH_CLIENT_ID=
CODE_RELAY_MCP_OAUTH_REDIRECT_URIS=
CODE_RELAY_OAUTH_CODE_TTL=60s

# Required for a multi-instance SaaS deployment. Keep both services on a
# private network and supply credentials through a secret manager in prod.
CODE_RELAY_DATABASE_URL=postgres://code_relay:replace-me@postgres.internal:5432/code_relay?sslmode=require
CODE_RELAY_REDIS_URL=rediss://:replace-me@redis.internal:6379/0
CODE_RELAY_REDIS_KEY_PREFIX=code-relay:
# Set to redis after provisioning a reachable Redis instance; memory is the
# default single-instance mode.
CODE_RELAY_SESSION_STORE=memory
CODE_RELAY_SESSION_TTL=30m
CODE_RELAY_EVENT_RETENTION=24h
# Use redis for every production deployment; memory is only for one-instance
# staging. Cookie mode is retained solely for compatibility tests.

# Streamable HTTP operational limits. Heartbeats must be shorter than the
# reverse-proxy idle timeout; see reverse-proxy-streamable-http.conf.example.
CODE_RELAY_SSE_HEARTBEAT_SECONDS=15
CODE_RELAY_SSE_MAX_CONNECTIONS=1000
CODE_RELAY_SSE_MAX_QUEUE=256
CODE_RELAY_SSE_EVENT_HISTORY=256
CODE_RELAY_CORS_ALLOWED_ORIGINS=https://chatgpt.com

# Local/staging mode only (leave unset in hosted mode).
# CODE_RELAY_MCP_ROOT=/workspace/project
# CODE_RELAY_MCP_TOKEN=replace-with-a-random-32-character-secret

# Optional: exact token supplied by the OpenAI plugin submission portal.
OPENAI_APPS_CHALLENGE=

# Optional controls. Defaults are safe for a small staging gateway.
CODE_RELAY_MCP_RATE_PER_MINUTE=60
CODE_RELAY_MCP_MAX_CONCURRENT=4
CODE_RELAY_MCP_TIMEOUT_SECONDS=60
PORT=8080
