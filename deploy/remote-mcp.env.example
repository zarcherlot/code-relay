# Hosted mode (recommended for public ChatGPT submission) does not use a local
# checkout or CODE_RELAY_MCP_TOKEN. GitHub is the runbook/receipt source of truth.
CODE_RELAY_GITHUB_OAUTH_CLIENT_ID=
CODE_RELAY_GITHUB_OAUTH_CLIENT_SECRET=
# Prefer a mounted secret file in production; inline value takes precedence.
# CODE_RELAY_GITHUB_OAUTH_CLIENT_SECRET_FILE=/run/secrets/code-relay-github-oauth-client-secret
CODE_RELAY_GITHUB_OAUTH_REDIRECT_URL=https://mcp.example.com/auth/github/callback
CODE_RELAY_SESSION_SECRET=replace-with-a-random-32-character-secret
CODE_RELAY_GITHUB_APP_ID=
CODE_RELAY_GITHUB_APP_SLUG=code-relay
CODE_RELAY_GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/code-relay-github-app.pem
CODE_RELAY_GITHUB_WORKFLOW=checkpoint.yml
# Optional branch policy. Values are refs/heads/main or owner/repo@refs/heads/main.
CODE_RELAY_ALLOWED_REFS=

# Optional GitHub Enterprise endpoints.
CODE_RELAY_GITHUB_OAUTH_URL=https://github.com
CODE_RELAY_GITHUB_API_URL=https://api.github.com
CODE_RELAY_COOKIE_DOMAIN=
CODE_RELAY_COOKIE_SECURE=true

# Local/staging mode only (leave unset in hosted mode).
# CODE_RELAY_MCP_ROOT=/workspace/project
# CODE_RELAY_MCP_TOKEN=replace-with-a-random-32-character-secret

# Optional: exact token supplied by the OpenAI plugin submission portal.
OPENAI_APPS_CHALLENGE=

# Optional controls. Defaults are safe for a small staging gateway.
CODE_RELAY_MCP_RATE_PER_MINUTE=60
CODE_RELAY_MCP_MAX_CONCURRENT=4
CODE_RELAY_MCP_TIMEOUT_SECONDS=60
PORT=8080
